# ============================================================
# DOCKERFILE do FRONTEND (React + Vite)
# Onde colocar: renomeie para "Dockerfile" e coloque na RAIZ
# do projeto conduzir-frontend (mesma pasta do package.json)
# ============================================================

# ---------- ETAPA 1: BUILD (compila o React) ----------
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build
# Isso gera a pasta /app/dist com os arquivos estaticos prontos

# ---------- ETAPA 2: SERVIDOR (nginx entrega os arquivos) ----------
FROM nginx:alpine

# Copia os arquivos prontos (HTML/CSS/JS) para o nginx servir
COPY --from=build /app/dist /usr/share/nginx/html

# Configuracao para o React Router funcionar (evita erro 404 ao atualizar a pagina)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
